conn.commit()

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_orders_cost AS
SELECT 
    o.order_id,
    o.customer_name,
    b.title,
    (o.quantity * b.price) AS total_price,
    a.name AS author_name
FROM orders o
JOIN books b ON o.book_id = b.book_id
JOIN authors a ON b.author_id = a.author_id;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_total_orders AS
SELECT COUNT(*) AS total_count
FROM orders;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_shipped_customers AS
SELECT customer_name, status
FROM orders
WHERE status = 'Shipped'
ORDER BY customer_name DESC
LIMIT 2 OFFSET 1;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_years_range AS
SELECT MIN(year_published) AS min_year, MAX(year_published) AS max_year
FROM books;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_avg_modern_price AS
SELECT AVG(price) AS avg_price
FROM books
WHERE year_published > 1900;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_min_price AS
SELECT MIN(price) AS minimum_price
FROM books;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_avg_stock_1984 AS
SELECT AVG(stock_qty) AS avg_stock
FROM books
WHERE title = "1984";
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_sum_price_in_stock AS
SELECT SUM(price) AS sum_price
FROM books
WHERE stock_qty > 10;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_genres_count AS
SELECT a.genre_focus, COUNT(*) AS quantity
FROM books b
JOIN authors a ON b.author_id = a.author_id
GROUP BY a.genre_focus;
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS table_earliest_orders AS
SELECT status, MIN(order_date) AS min_date
FROM orders
GROUP BY status;
''')

conn.commit()

cursor.execute("SELECT * FROM table_earliest_orders;")
results = cursor.fetchall()

print("Содержимое таблицы table_earliest_orders:")
for row in results:
